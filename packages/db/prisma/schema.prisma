// PAGE OS — Data model (สเปกข้อ 3)
//
// กฎที่สะท้อนอยู่ใน schema นี้:
//   - กฎข้อ 3: token เก็บเป็น ciphertext เท่านั้น (คอลัมน์ชื่อ encrypted_token)
//   - กฎข้อ 4: เวลาทุกคอลัมน์เป็น UTC (@db.Timestamptz)
//   - กฎข้อ 6: webhook idempotent ด้วย mid / comment_id → unique index

generator client {
  provider        = "prisma-client-js"
  // ต้องเปิด preview นี้ถึงจะประกาศ extension ในไฟล์ schema ได้
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ---------------------------------------------------------------- workspace

model Workspace {
  id         String   @id @default(uuid())
  name       String
  clientName String   @map("client_name")
  brandConfig Json    @default("{}") @map("brand_config")
  plan       String   @default("STARTER")
  /// SLA ที่สัญญากับลูกค้า (นาที) — STARTER 240 / GROWTH 60 / FULL 30
  slaMinutes Int      @default(240) @map("sla_minutes")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  pages        Page[]
  auditLogs    AuditLog[]
  trackedPages TrackedPage[]

  @@map("workspaces")
}

model Page {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  fbPageId    String   @unique @map("fb_page_id")
  igUserId    String?  @map("ig_user_id")
  name        String
  category    String?
  /// timezone ของเพจ ใช้ตอนแสดงผล — ใน DB เก็บ UTC เสมอ (กฎข้อ 4)
  timezone    String   @default("Asia/Bangkok")
  /// ปุ่มปิดบอทฉุกเฉินต่อเพจ (M2 Bot Kill Switch)
  botEnabled  Boolean  @default(true) @map("bot_enabled")
  /// ได้รับ webhook ล่าสุดเมื่อไหร่ — สเปกข้อ M8 ต้องเตือนเมื่อเงียบเกิน 30 นาที
  /// null = ยังไม่เคยได้รับเลย ซึ่งแปลว่า subscribe ไม่สำเร็จ ไม่ใช่ว่าไม่มีคนทัก
  lastWebhookAt DateTime? @map("last_webhook_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tokens          PageToken[]
  contacts        Contact[]
  conversations   Conversation[]
  posts           Post[]
  postTargets     PostTarget[]
  comments        Comment[]
  botFlows        BotFlow[]
  knowledgeDocs   KnowledgeDoc[]
  automationRules AutomationRule[]
  leads           Lead[]
  insights        InsightsDaily[]
  trackedPages    TrackedPage[]

  @@index([workspaceId])
  @@map("pages")
}

// ------------------------------------------------------------------- tokens

enum TokenStatus {
  active
  expiring_soon
  expired
  revoked
  missing_permissions
  unknown

  @@map("token_status")
}

enum TokenKind {
  user
  page
  system_user
  app

  @@map("token_kind")
}

model PageToken {
  id     String @id @default(uuid())
  pageId String @map("page_id")
  /// ciphertext จาก encryptToken() เท่านั้น — ห้ามเก็บ plaintext (กฎข้อ 3)
  encryptedToken String      @map("encrypted_token")
  tokenType      TokenKind   @default(page) @map("token_type")
  scopes         String[]    @default([])
  expiresAt      DateTime?   @map("expires_at") @db.Timestamptz(6)
  lastCheckedAt  DateTime?   @map("last_checked_at") @db.Timestamptz(6)
  status         TokenStatus @default(unknown)
  /// ข้อความไทยอธิบายสถานะล่าสุด ใช้แสดงในหน้า Connection Status
  statusReason   String?     @map("status_reason")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  /// 1 เพจมี token ที่ใช้งานได้ 1 ตัวต่อชนิด
  @@unique([pageId, tokenType])
  @@index([status])
  @@index([expiresAt])
  @@map("page_tokens")
}

// ------------------------------------------------------------ inbox / CRM

model Contact {
  id        String   @id @default(uuid())
  pageId    String   @map("page_id")
  psid      String?
  igId      String?  @map("ig_id")
  name      String?
  avatar    String?
  tags      String[] @default([])
  firstSeen DateTime @default(now()) @map("first_seen") @db.Timestamptz(6)
  lastSeen  DateTime @default(now()) @map("last_seen") @db.Timestamptz(6)

  page          Page           @relation(fields: [pageId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  leads         Lead[]

  @@unique([pageId, psid])
  @@unique([pageId, igId])
  @@index([pageId, lastSeen])
  @@map("contacts")
}

enum Channel {
  messenger
  instagram
  comment
  rating

  @@map("channel")
}

model Conversation {
  id        String  @id @default(uuid())
  pageId    String  @map("page_id")
  contactId String  @map("contact_id")
  channel   Channel
  status    String  @default("open")
  /// ลูกค้าทักล่าสุดเมื่อไหร่ — ต้นทางของหน้าต่าง 24 ชม.
  ///
  /// เก็บแยกจาก `windowExpiresAt` เพราะสองค่านี้ตอบคนละคำถาม: ตัวนี้คือข้อเท็จจริง
  /// ("ทักตอนไหน") ส่วนตัวนั้นคือค่าที่คำนวณมาแล้วเพื่อให้ query หา
  /// "ใกล้หมดเวลา" ได้เร็ว ถ้าเก็บแต่ตัวที่คำนวณแล้ว วันที่ Meta เปลี่ยนความยาว
  /// หน้าต่าง เราจะย้อนคำนวณของเก่าไม่ได้เลย
  lastCustomerMessageAt DateTime? @map("last_customer_message_at") @db.Timestamptz(6)
  /// ข้อความที่ยังไม่ได้ตอบเริ่มตั้งแต่เมื่อไหร่ — null = ตอบครบแล้ว
  /// ต้นทางของ `slaDueAt` ด้วยเหตุผลเดียวกับข้างบน
  awaitingSince   DateTime? @map("awaiting_since") @db.Timestamptz(6)
  /// หมดเวลา 24 ชม. เมื่อไหร่ — ใช้แสดง badge นับถอยหลังใน M1
  windowExpiresAt DateTime? @map("window_expires_at") @db.Timestamptz(6)
  /// บอทหยุดพูดจนถึงเมื่อไหร่ — เซ็ตทุกครั้งที่คนพิมพ์เอง (ข้อ 6.3)
  botPausedUntil  DateTime? @map("bot_paused_until") @db.Timestamptz(6)
  assignedTo      String?   @map("assigned_to")
  slaDueAt        DateTime? @map("sla_due_at") @db.Timestamptz(6)
  unread          Int       @default(0)
  /// โน้ตภายใน ลูกค้าไม่เห็น (M1)
  internalNote    String?   @map("internal_note")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  page     Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  contact  Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([pageId, status])
  @@index([windowExpiresAt])
  @@index([slaDueAt])
  @@map("conversations")
}

enum Direction {
  inbound
  outbound

  @@map("direction")
}

/// ใครเป็นคนส่ง — HUMAN_AGENT tag ใช้ได้เฉพาะ human เท่านั้น (กฎข้อ 7)
enum SentBy {
  human
  bot
  system

  @@map("sent_by")
}

model Message {
  id             String    @id @default(uuid())
  conversationId String    @map("conversation_id")
  direction      Direction
  sentBy         SentBy    @map("sent_by")
  body           String?
  attachments    Json      @default("[]")
  /// mid ของ Meta — unique key สำหรับ idempotency (กฎข้อ 6)
  mid            String?   @unique
  tagUsed        String?   @map("tag_used")
  deliveryStatus String    @default("pending") @map("delivery_status")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

// -------------------------------------------------------------- publishing

enum PostStatus {
  draft
  pending_approval
  scheduled
  publishing
  published
  failed
  cancelled

  @@map("post_status")
}

model Post {
  id           String     @id @default(uuid())
  pageId       String     @map("page_id")
  type         String     @default("text")
  body         String
  /// URL ของโพสต์ประเภท "ลิงก์"
  /// ถ้าไม่มีคอลัมน์นี้ โพสต์ประเภทลิงก์จะล้มเหลวทุกใบด้วยข้อความ
  /// 'โพสต์ประเภท "ลิงก์" ต้องระบุ URL' โดยไม่มีทางแก้ให้สำเร็จได้เลย
  link         String?
  media        Json       @default("[]")
  scheduledAt  DateTime?  @map("scheduled_at") @db.Timestamptz(6)
  publishedAt  DateTime?  @map("published_at") @db.Timestamptz(6)
  fbPostId     String?    @map("fb_post_id")
  status       PostStatus @default(draft)
  /// hash ของเนื้อหา ใช้กันโพสต์ซ้ำใน 90 วัน (M4 Duplicate Guard)
  contentHash    String   @map("content_hash")
  approvalStatus String   @default("none") @map("approval_status")
  createdBy      String?  @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  page     Page         @relation(fields: [pageId], references: [id], onDelete: Cascade)
  targets  PostTarget[]
  comments Comment[]

  @@index([pageId, contentHash, publishedAt])
  @@index([status, scheduledAt])
  @@map("posts")
}

model PostTarget {
  id           String     @id @default(uuid())
  postId       String     @map("post_id")
  pageId       String     @map("page_id")
  overrideBody String?    @map("override_body")
  fbPostId     String?    @map("fb_post_id")
  status       PostStatus @default(scheduled)
  error        String?
  /// ลองยิงไปแล้วกี่รอบ — ตัวตัดสิน retry อ่านค่านี้ และ PublishWorker ใช้มัน
  /// ตัดสินว่าต้องไปถาม Meta ก่อนไหมว่ารอบที่แล้วโพสต์ขึ้นไปแล้วหรือยัง
  /// (ทำเฉพาะรอบที่ 2 ขึ้นไป) ถ้าค่านี้ไม่ขยับ = ยิงซ้ำบนเพจลูกค้า
  attempts     Int        @default(0)
  publishedAt  DateTime?  @map("published_at") @db.Timestamptz(6)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([postId, pageId])
  @@index([status])
  @@map("post_targets")
}

model Comment {
  id           String    @id @default(uuid())
  postId       String?   @map("post_id")
  pageId       String    @map("page_id")
  /// unique เพื่อ idempotency ของ webhook feed (กฎข้อ 6)
  fbCommentId  String    @unique @map("fb_comment_id")
  authorId     String?   @map("author_id")
  authorName   String?   @map("author_name")
  body         String?
  sentiment    String?
  actionTaken  String?   @map("action_taken")
  /// Private Reply ทำได้ครั้งเดียวต่อคอมเมนต์ ภายใน 7 วัน (M3)
  privateRepliedAt DateTime? @map("private_replied_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  post Post? @relation(fields: [postId], references: [id], onDelete: SetNull)
  page Page  @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, createdAt])
  @@map("comments")
}

// ------------------------------------------------------------------- bot

model BotFlow {
  id        String   @id @default(uuid())
  pageId    String   @map("page_id")
  name      String
  graphJson Json     @map("graph_json")
  isActive  Boolean  @default(false) @map("is_active")
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, name, version])
  @@index([pageId, isActive])
  @@map("bot_flows")
}

model KnowledgeDoc {
  id        String   @id @default(uuid())
  pageId    String   @map("page_id")
  title     String
  source    String?
  chunkText String   @map("chunk_text")
  /// pgvector — ต้องสร้าง index ด้วย migration แยก (Prisma ยังไม่รองรับ vector index)
  embedding Unsupported("vector(768)")?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
  @@map("knowledge_docs")
}

model AutomationRule {
  id          String   @id @default(uuid())
  pageId      String   @map("page_id")
  triggerType String   @map("trigger_type")
  pattern     String
  action      Json
  priority    Int      @default(100)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, isActive, priority])
  @@map("automation_rules")
}

model Lead {
  id         String    @id @default(uuid())
  pageId     String    @map("page_id")
  contactId  String?   @map("contact_id")
  fieldsJson Json      @default("{}") @map("fields_json")
  status     String    @default("new")
  exportedAt DateTime? @map("exported_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  page    Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([pageId, status])
  @@map("leads")
}

// -------------------------------------------------------------- analytics

model InsightsDaily {
  pageId    String   @map("page_id")
  date      DateTime @db.Date
  metricKey String   @map("metric_key")
  value     Float

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@id([pageId, date, metricKey])
  @@index([pageId, metricKey, date])
  @@map("insights_daily")
}

// ------------------------------------------------------------------- ops

model Job {
  id        String    @id @default(uuid())
  type      String
  payload   Json
  runAt     DateTime  @map("run_at") @db.Timestamptz(6)
  attempts  Int       @default(0)
  lastError String?   @map("last_error")
  status    String    @default("pending")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status, runAt])
  @@map("jobs")
}

model AuditLog {
  id          String   @id @default(uuid())
  workspaceId String?  @map("workspace_id")
  /// fb_page_id ของเพจที่ถูกกระทำ — สเปกข้อ M8 ต้องตอบได้ว่า "ทำกับเพจไหน"
  /// เก็บเป็นสตริงอิสระ ไม่ผูก FK เพราะ log ต้องอยู่ต่อแม้เพจถูกลบ
  pageId      String?  @map("page_id")
  /// รูปแบบ "kind:id" เช่น "human:me@example.com" / "system:worker:publish"
  actor       String
  action      String
  target      String?
  /// ข้อความไทยที่คนอ่านตอนสอบสวนย้อนหลัง
  summaryTh   String?  @map("summary_th")
  meta        Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([pageId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

/// สถานะการแจ้งเตือนที่ยังค้างอยู่ (M-I Alert Center)
/// เก็บใน DB เพราะ worker รีสตาร์ทแล้วต้องไม่เตือนซ้ำทุกเรื่องใหม่หมด
model AlertState {
  problemId     String   @id @map("problem_id")
  pageId        String?  @map("page_id")
  pageName      String   @map("page_name")
  firstSeenAt   DateTime @map("first_seen_at") @db.Timestamptz(6)
  lastSentAt    DateTime? @map("last_sent_at") @db.Timestamptz(6)
  sendCount     Int      @default(0) @map("send_count")
  lastSeverity  String   @map("last_severity")
  /// ความรุนแรงสูงสุดที่เคยแจ้งไปแล้ว — ใช้ตัดสินการยกระดับ
  peakSeverity  String   @map("peak_severity")
  lastTh        String   @map("last_th")

  @@index([lastSentAt])
  @@map("alert_states")
}

/// event จาก webhook ที่ประมวลผลไปแล้ว (กฎข้อ 6)
///
/// ต้องมีตารางแยก ไม่ใช้ `messages.mid` แทน เพราะ event ที่ต้องกันซ้ำมีมากกว่า
/// ข้อความ — รีแอ็กชัน คอมเมนต์ และรีวิว ไม่ได้สร้างแถวใน `messages` เลย
/// แต่ Meta ส่งซ้ำได้เหมือนกัน
model WebhookSeen {
  /// คีย์จาก `idempotencyKey()` เช่น "msg:m_1" / "comment:c_1:add"
  key    String   @id
  seenAt DateTime @default(now()) @map("seen_at") @db.Timestamptz(6)

  /// ใช้ล้างของเก่าทิ้ง — ตารางนี้โตตามจำนวน event ไม่ใช่จำนวนบทสนทนา
  @@index([seenAt])
  @@map("webhook_seen")
}

/// ลิงก์เข้าระบบที่ถูกใช้ไปแล้ว (M-H) — กันใช้ซ้ำ
model UsedMagicLink {
  jti       String   @id
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  @@index([expiresAt])
  @@map("used_magic_links")
}

/// log ทุก call ที่ยิงไป Meta (สเปกข้อ 5 หน้าที่ 7)
/// ใช้ตอบคำถามลูกค้าว่า "ทำไมโพสต์ไม่ขึ้น"
model MetaCallLog {
  id           String   @id @default(uuid())
  pageId       String?  @map("page_id")
  method       String
  path         String
  httpStatus   Int?     @map("http_status")
  ok           Boolean
  durationMs   Int      @map("duration_ms")
  attempts     Int      @default(1)
  errorCode    Int?     @map("error_code")
  errorSubcode Int?     @map("error_subcode")
  errorMessage String?  @map("error_message")
  errorTh      String?  @map("error_th")
  fbtraceId    String?  @map("fbtrace_id")
  appUsagePct  Float?   @map("app_usage_pct")
  pageUsagePct Float?   @map("page_usage_pct")
  priority     String   @default("normal")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([pageId, createdAt])
  @@index([ok, createdAt])
  @@map("meta_call_logs")
}

// -------------------------------------------------------------- listening
//
// ─── ทำไมไม่ใช้ตาราง `pages` / `posts` / `comments` ที่มีอยู่แล้ว ───
//
// ตารางชุดนั้นคือ "เพจที่เราดูแล" — มี token, มี workspace, โพสต์ผ่านระบบเรา
// ส่วนชุดนี้คือ "เพจที่เราเฝ้าดู" ซึ่งรวมเพจคู่แข่งที่เราไม่ได้เป็นแอดมิน
// ไม่มี token ให้ และแก้อะไรไม่ได้เลยนอกจากอ่าน
//
// ถ้าเอามารวมตารางเดียวกัน ทุกที่ที่วนลูป `pages` เพื่อทำงาน (ยิงโพสต์,
// ตอบแชท, ต่ออายุ token) จะเจอเพจคู่แข่งปนเข้ามา แล้วต้องไปเติมเงื่อนไข
// กรองออกทีละจุด — พลาดจุดเดียวคือพยายามโพสต์ลงเพจชาวบ้าน

enum TrackedKind {
  /// เพจของเราเอง — ดึงข้อมูลด้วย Page Access Token ของเพจนั้น
  OWNED
  /// เพจคู่แข่ง — ต้องมีสิทธิ์ Page Public Content Access หรือแหล่งข้อมูลภายนอก
  COMPETITOR
  /// กลุ่มสาธารณะ
  GROUP
}

enum TrackedSource {
  /// ดึงผ่าน MetaGateway ด้วย token ของเพจเราเอง
  META_API
  /// ดึงผ่าน YouTubeGateway — ของสาธารณะใช้ API key เฉยๆ ไม่ต้องมี token ของช่อง
  YOUTUBE_API
  /// มาจากผู้ให้บริการข้อมูลภายนอก (ใช้ตอนยังไม่ผ่าน App Review ของ Meta)
  EXTERNAL
  /// คนกรอกเอง
  MANUAL
}

/// แพลตฟอร์มของสิ่งที่เฝ้าดู
///
/// ─── ทำไมรวมตารางเดียวกัน ไม่แยก TrackedChannel ออกไป ───
///
/// เพราะสิ่งที่เราทำกับมันเหมือนกันทุกอย่าง: นับ engagement, จัดหมวดคอมเมนต์
/// ภาษาไทย, หาแฟนตัวยง, สแกนบัญชีน่าสงสัย, ส่งออก CSV — โมดูลพวกนี้ใน
/// `packages/listening` เป็นฟังก์ชันบริสุทธิ์ที่รับ "ข้อความ + คนเขียน + เวลา"
/// ไม่เคยรู้จักว่ามาจากไหน
///
/// แยกตารางจะได้โค้ดสองชุดที่ต้องแก้พร้อมกันตลอดไป และหน้า "อ่านคอมเมนต์"
/// จะรวมสองแพลตฟอร์มในหน้าเดียวไม่ได้
enum TrackedPlatform {
  FACEBOOK
  YOUTUBE
}

model TrackedPage {
  id          String        @id @default(uuid())
  workspaceId String        @map("workspace_id")
  /// เฟซบุ๊กหรือยูทูบ — ตัวชี้ว่าจะดึงข้อมูลผ่าน gateway ตัวไหน
  platform    TrackedPlatform @default(FACEBOOK)
  /// รหัสของสิ่งที่เฝ้าดูบนแพลตฟอร์มนั้น
  ///
  /// FACEBOOK = รหัสเพจ · YOUTUBE = รหัสช่อง (ขึ้นต้นด้วย UC)
  ///
  /// ⚠️ คอลัมน์ในฐานข้อมูลยังชื่อ `fb_page_id` เพราะเปลี่ยนชื่อคอลัมน์จริง
  /// ต้องย้ายข้อมูล ซึ่งเสี่ยงกว่าประโยชน์ที่ได้ — ชื่อฟิลด์ฝั่งโค้ดสำคัญกว่า
  /// เพราะเป็นตัวที่คนอ่านทุกวัน (บทเรียนจาก "pageId สองความหมาย")
  externalId  String        @map("fb_page_id")
  name        String
  kind        TrackedKind
  source      TrackedSource @default(META_API)
  /// null = ยังไม่รู้ตัวเลขนี้ ต่างจาก 0 ที่แปลว่ารู้แล้วว่าไม่มีคนตาม
  /// ปัจจัย "ผู้ติดตาม" ในหน้าเทียบเพจแยกไม่ได้ถ้าค่านี้เป็น null
  followers   Int?
  /// เพจของเราเองผูกกลับไปที่ตาราง pages — คู่แข่งเป็น null
  pageId      String?       @map("page_id")
  /// ดึงข้อมูลสำเร็จครั้งล่าสุดเมื่อไหร่ — null = ยังไม่เคยดึงเลย
  lastFetchedAt DateTime?   @map("last_fetched_at") @db.Timestamptz(6)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  page      Page?                 @relation(fields: [pageId], references: [id], onDelete: SetNull)
  posts     TrackedPost[]
  snapshots TrackedPageSnapshot[]

  /// เพจเดียวกันเฝ้าซ้ำใน workspace เดิมไม่ได้ แต่คนละ workspace เฝ้าเพจเดียวกันได้
  @@unique([workspaceId, externalId])
  @@index([workspaceId, kind])
  @@map("tracked_pages")
}

model TrackedPost {
  id            String   @id @default(uuid())
  trackedPageId String   @map("tracked_page_id")
  /// รหัสโพสต์/วิดีโอบนแพลตฟอร์มนั้น — คอลัมน์ยังชื่อ `fb_post_id` ตามเดิม
  /// ด้วยเหตุผลเดียวกับ `TrackedPage.externalId`
  externalId    String   @map("fb_post_id")
  publishedAt   DateTime @map("published_at") @db.Timestamptz(6)
  message       String?
  permalink     String?
  /// ยอด ณ ตอนที่ดึงล่าสุด ไม่ใช่ยอดสะสมรายวัน — Meta ไม่ได้ให้ timestamp
  /// ของรีแอ็กชันมา จึงบอกได้แค่ "ตอนนี้เท่าไร" ดูเหตุผลเต็มที่ engagement.ts
  reactions     Int      @default(0)
  shares        Int      @default(0)
  commentCount  Int      @default(0) @map("comment_count")
  fetchedAt     DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)

  trackedPage TrackedPage      @relation(fields: [trackedPageId], references: [id], onDelete: Cascade)
  comments    TrackedComment[]

  @@unique([trackedPageId, externalId])
  /// ดัชนีหลักของทั้งระบบ — ทุกหน้าจอถามว่า "เพจนี้ ช่วงนี้ มีโพสต์อะไรบ้าง"
  @@index([trackedPageId, publishedAt])
  @@map("tracked_posts")
}

model TrackedComment {
  id            String   @id @default(uuid())
  trackedPostId String   @map("tracked_post_id")
  /// รหัสคอมเมนต์บนแพลตฟอร์มนั้น — คอลัมน์ยังชื่อ `fb_comment_id` ตามเดิม
  externalId    String   @map("fb_comment_id")
  /// id ของคนคอมเมนต์
  ///
  /// Facebook ให้มาเป็น scoped id ต่างกันในแต่ละเพจ จึงเอามาจับว่า
  /// "คนเดียวกัน" ข้ามเพจไม่ได้ ต้องอาศัยชื่อซึ่งไม่แม่นเสมอ
  ///
  /// YouTube ให้ channel id ของคนคอมเมนต์ซึ่ง**เหมือนกันทุกที่** —
  /// ฝั่ง YouTube จึงจับคนข้ามช่องได้แม่นกว่า Facebook มาก
  authorId      String?  @map("author_id")
  authorName    String?  @map("author_name")
  message       String?
  createdAt     DateTime @map("created_at") @db.Timestamptz(6)
  fetchedAt     DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)

  trackedPost TrackedPost @relation(fields: [trackedPostId], references: [id], onDelete: Cascade)

  @@unique([trackedPostId, externalId])
  @@index([trackedPostId, createdAt])
  /// หา "ใครคอมเมนต์บ่อยสุด" โดยไม่ต้องอ่านทั้งตาราง
  @@index([authorName])
  @@map("tracked_comments")
}

/// จำนวนผู้ติดตามย้อนหลัง — Meta ให้มาแต่ค่า ณ ปัจจุบัน ถ้าไม่จดไว้เองทุกวัน
/// จะย้อนดูไม่ได้เลยว่าเดือนที่แล้วมีเท่าไร ซึ่งทำให้เทียบข้ามช่วงเวลาไม่ได้
model TrackedPageSnapshot {
  trackedPageId String   @map("tracked_page_id")
  date          DateTime @db.Date
  followers     Int

  trackedPage TrackedPage @relation(fields: [trackedPageId], references: [id], onDelete: Cascade)

  @@id([trackedPageId, date])
  @@map("tracked_page_snapshots")
}
