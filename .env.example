# ---------------------------------------------------------------
# Facebook AI Page Manager — ตัวอย่างค่าตั้ง (ห้ามใส่ค่าจริงในไฟล์นี้)
# ใช้:  cp env.example .env   แล้วกรอกค่าจริง — .env อยู่ใน .gitignore
# .env.example และ env.example เป็นตัวอย่างเดียวกัน ห้าม commit .env ที่มีค่าจริง
# ---------------------------------------------------------------

# Application
APP_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000
WEB_PORT=3000
# ค่าเริ่มต้นของ workspace ที่สร้างใหม่เท่านั้น (AGENTS.md §87 — ห้ามถือเป็นค่าตายตัวของระบบ)
DEFAULT_TIMEZONE=Asia/Bangkok

# Database (PostgreSQL 16)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fbpm?schema=public
POSTGRES_PASSWORD=postgres

# Redis 7
REDIS_URL=redis://localhost:6379

# Auth
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Meta — เชื่อมเพจได้ 2 ทาง (Phase 3):
#  1) วาง user token ในหน้า "เพจ" (ไม่ต้องตั้งค่าอะไรเพิ่ม — token จาก Graph API Explorer ที่ extend แล้ว)
#  2) ปุ่ม "เชื่อมด้วย Facebook" (OAuth) — ต้องกรอก META_APP_ID/META_APP_SECRET และตั้ง redirect URI ในแอป Meta ให้ตรง
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v26.0
META_OAUTH_REDIRECT_URI=http://localhost:4000/facebook/oauth/callback
# ใช้เฉพาะ test: ชี้ Graph ไปที่ mock (ดู packages/facebook-core/src/mock-graph.ts)
# META_GRAPH_BASE_URL=
# Webhook (§14): ตั้ง Callback URL = <API_URL>/facebook/webhook ในแอป Meta, verify token ตรงกับค่านี้ ลายเซ็นตรวจด้วย META_APP_SECRET
META_WEBHOOK_VERIFY_TOKEN=

# AI platform-managed providers (Phase: AI Gateway — ยังไม่ใช้ใน Phase 1)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
OPENROUTER_API_KEY=

# Optional AI Gateway
LITELLM_BASE_URL=
LITELLM_API_KEY=

# Storage (S3-compatible เช่น MinIO)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=fbpm
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Deploy (docker compose + Caddy)
DOMAIN=localhost
APP_PUBLIC_API_URL=/api

# อีเมล (§65) — ไม่ตั้ง SMTP_HOST = ปิดอีเมล (ลิงก์เชิญ/รีเซ็ตยังคัดลอกส่งเองได้) ส่ง: คำเชิญ, ลิงก์ตั้งรหัสใหม่/ลืมรหัสผ่าน, แจ้งเตือนสำคัญ (โพสต์ล้มเหลว/ต้องเชื่อมใหม่/รออนุมัติ/ลีดร้อน) ถึง owner+admin
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AI Page Manager <no-reply@example.com>"
# true เมื่อใช้พอร์ต 465 (SMTPS); พอร์ต 587 ระบบทำ STARTTLS ให้เอง — ถ้าเซิร์ฟเวอร์ไม่มี TLS ระบบจะไม่ส่งรหัสผ่าน
SMTP_SECURE=false
SMTP_ALLOW_INSECURE=false

# Media service (§63): โฟลเดอร์เก็บภาพที่ระบบสร้าง + Chromium สำหรับเรนเดอร์การ์ด (API และ worker ต้องเห็น path เดียวกัน)
MEDIA_DIR=./data/media
CHROME_BIN=

# ---------- YouTube module (AGENTS_YOUTUBE.md §144) — ไม่ใส่ก็เปิดระบบได้ แต่หน้า YouTube จะขึ้น "ยังไม่ตั้งค่า" ----------
# Google Cloud → OAuth client (Web application) — redirect URI ต้องตรงกับ <API_URL>/youtube/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/youtube/oauth/callback
# API key สำหรับอ่านช่องสาธารณะ (วิเคราะห์อย่างเดียว ไม่มี Analytics/อัปโหลด) — เปิด YouTube Data API v3 ในโปรเจกต์
YOUTUBE_API_KEY=
# อัปโหลดผ่านระบบ — เปิดเมื่อแอปผ่าน verification/audit แล้ว; false = โหมดเตรียมแพ็กเกจ (§104)
YOUTUBE_UPLOAD_ENABLED=false
YOUTUBE_DEFAULT_SYNC_DAYS=90
# โควตา Data API ต่อวัน (ค่าเริ่มต้นของ Google 10,000) — ระบบเตือนเมื่อใกล้หมด
YOUTUBE_QUOTA_SOFT_LIMIT=10000
# ทดสอบเท่านั้น: ชี้ทุก endpoint ของ Google/YouTube ไป mock (test/phase9-smoke.mjs) — ห้ามตั้งใน production
YOUTUBE_MOCK_BASE_URL=

# ---------- Website Care (AGENTS_WEB.md §7) ----------
# Google Cloud → เปิด "PageSpeed Insights API" → API key (ฟรี ~25,000 คำขอ/วัน) — ไม่ใส่ = ข้าม Core Web Vitals (แสดง "ไม่มีข้อมูล")
PAGESPEED_API_KEY=
# Search Console ใช้ GOOGLE_CLIENT_ID/SECRET เดิม — ตอน "เชื่อมบัญชี Google" ต้องเลือกฟีเจอร์ค้นหา (scope webmasters.readonly)
# ทดสอบเท่านั้น: mock PageSpeed + Search Console และอนุญาตเป้าหมาย 127.0.0.1 — ห้ามตั้งใน production
WEB_MOCK_BASE_URL=
WEB_ALLOW_PRIVATE_TARGETS=false

# ---------- W-3 บทความขึ้นเว็บลูกค้า (WordPress) ----------
# เปิดให้ระบบโพสต์บทความที่ "อนุมัติแล้ว" ขึ้น WordPress จริง (ค่าเริ่มต้น false = ร่าง/อนุมัติได้ แต่ยังไม่ยิงขึ้นเว็บ)
WEB_PUBLISH_ENABLED=false
# ทดสอบเท่านั้น: ยอมให้เชื่อม WordPress ผ่าน http:// (production ต้อง https เพราะรหัสผ่านอยู่ใน header)
WEB_WP_ALLOW_INSECURE=false

# ---------- W-4 อีเมลการตลาด (AGENTS_WEB.md) ----------
# ผู้ให้บริการส่งจำนวนมาก (Brevo/Resend) ตั้ง API key ในหน้า "อีเมล" ของแต่ละ workspace ไม่ใช่ที่นี่ (เก็บเข้ารหัสใน DB)
# สวิตช์ระดับระบบ: เปิดให้ส่งอีเมลจริง (ค่าเริ่มต้น false = ร่าง/อนุมัติได้ แต่ยังไม่ส่ง)
EMAIL_SEND_ENABLED=false
# ทดสอบเท่านั้น: ชี้ผู้ให้บริการไป mock
EMAIL_MOCK_BASE_URL=

# ---------- TikTok MVP ----------
# Official TikTok developer app; leave blank to keep account connection disabled.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Registered HTTPS URL on the SAME origin as the web app: https://your-host/api/tiktok/oauth/callback
TIKTOK_REDIRECT_URI=
# Inbox upload only; creator must finish posting in TikTok. Default OFF.
SOCIAL_PUBLISHING_ENABLED=false
# Comma-separated HTTPS domains/path prefixes verified with TikTok; public MP4 URLs only.
TIKTOK_VERIFIED_MEDIA_PREFIXES=
# Test-only loopback override, rejected outside APP_ENV=test.
TIKTOK_MOCK_BASE_URL=
# Optional Gemini model override; workspace AI role selections take priority.
GOOGLE_AI_MODEL=

# Messenger keys/models are configured separately in the AI Messenger page, encrypted per workspace.
# Optional test-only AI fixture; leave empty for real OpenAI. See docs/MESSENGER.md.
MESSENGER_AI_MOCK_BASE_URL=
# Default review-only Messenger delivery. Enable only after explicit authorization.
MESSENGER_AUTO_SEND_ENABLED=false
