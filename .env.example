# PAGE OS — ตัวอย่าง environment variables
# ก๊อปเป็น .env แล้วใส่ค่าจริง — ห้าม commit .env

# ---------------------------------------------------------------- Meta App
# จาก Meta for Developers > App > Settings > Basic
META_APP_ID=
META_APP_SECRET=

# Graph API version — กฎข้อ 2: ที่เดียวในระบบที่กำหนดเวอร์ชัน
# v25.0 = ตัวปัจจุบัน ณ ส.ค. 2026
GRAPH_VERSION=v25.0

# URL ที่ Meta จะ redirect กลับหลังลูกค้ากดอนุญาต (ต้องตรงกับที่ตั้งใน App Settings)
META_OAUTH_REDIRECT_URI=https://your-domain.com/api/oauth/callback

# token ที่เราตั้งเองสำหรับให้ Meta ยืนยันตอน subscribe webhook
META_WEBHOOK_VERIFY_TOKEN=

# ------------------------------------------------------------ Token encryption
# กฎข้อ 3: token ต้องเข้ารหัส AES-256-GCM
# รูปแบบ: "keyId:base64key,keyId2:base64key2" — ตัวแรกคือตัวที่ใช้เข้ารหัสของใหม่
# ตอน rotate key ให้ใส่ key ใหม่ไว้หน้าสุด แล้วเก็บ key เก่าไว้ถอดของเดิม
#
# สร้าง key ใหม่:
#   node -e "console.log('k1:'+require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENC_KEYS=

# ---------------------------------------------------------------- Database
DATABASE_URL=postgresql://user:pass@localhost:5432/pageos?schema=public

# ---------------------------------------------------------------- Queue
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------- Alert
# LINE Messaging API สำหรับแจ้งเตือน token หมดอายุ / โพสต์ล้มเหลว / คอมเมนต์เชิงลบ
LINE_CHANNEL_ACCESS_TOKEN=
LINE_ADMIN_USER_ID=

# ---------------------------------------------------------------- ทั่วไป
LOG_LEVEL=info
NODE_ENV=development
