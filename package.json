{
  "name": "page-os",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "node scripts/ensure-prisma.mjs",
    "configure": "node scripts/setup.mjs",
    "preflight": "node scripts/doctor.mjs",
    "dev": "node scripts/ensure-prisma.mjs && tsc -b && node scripts/dev.mjs",
    "db:push": "node scripts/prisma.mjs db push",
    "db:migrate": "node scripts/prisma.mjs migrate dev",
    "db:generate": "node scripts/prisma.mjs generate",
    "db:studio": "node scripts/prisma.mjs studio",
    "build": "node scripts/ensure-prisma.mjs && tsc -b",
    "clean": "node scripts/clean.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "node scripts/ensure-prisma.mjs && tsc -b --force && tsc -p tsconfig.test.json",
    "check": "pnpm run typecheck && pnpm run test"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@prisma/client",
      "prisma",
      "@prisma/engines"
    ]
  }
}
